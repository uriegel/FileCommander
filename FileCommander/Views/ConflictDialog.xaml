<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FileCommander.Views.ConflictDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvh="using:WinUITools.ItemsRepeaterExtensions"
    xmlns:local="using:FileCommander.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:FileCommander.ValueConverters"
    mc:Ignorable="d" x:Name="Dialog" Title="Konflikte" Closed="Dialog_Closed">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24" KeyDown="Grid_KeyDown">
        <Grid.Resources>
            <DataTemplate x:Key="ItemDataTemplate">
                <cvh:ColumnViewItemGrid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="2, 0, 5, 0"  >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image VerticalAlignment="Top" Source="{Binding Converter={StaticResource IconImageConverter}}" Width="32" Height="32" Margin="0,0,15,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Padding="5, 0">
                        <TextBlock Text="{Binding SourceDate}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TargetDate}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Padding="5, 10">
                        <TextBlock Text="{Binding SourceSize}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TargetSize}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </cvh:ColumnViewItemGrid>
            </DataTemplate>
            <converters:IconImageConverter x:Key="IconImageConverter" />
        </Grid.Resources>        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="12" Margin="0,24">
            <ProgressBar Height="4" IsIndeterminate="True" FlowDirection="{Binding ElementName=Dialog, Path=FromRight, Converter={ StaticResource FromRightConverter}}"/>
            <TextBlock Name="Description" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Name="Grid" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <cvh:ColumnViewHeaders Name="Headers"/>
            <ScrollViewer Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                <ItemsRepeater x:Name="ListView" ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                    ScrollViewer.VerticalScrollBarVisibility="Visible" IsTabStop="False"
                    ItemTemplate="{StaticResource ItemDataTemplate}">
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" HorizontalAlignment="Right" Width="300">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.Children>
                <Button Name ="Yes" Content="Ja" HorizontalAlignment="Stretch" Margin="5" />
                <Button Name="No" Grid.Column="1" Content="Nein" HorizontalAlignment="Stretch" Margin="5" />
            </Grid.Children>
        </Grid>
    </Grid>
</Window>

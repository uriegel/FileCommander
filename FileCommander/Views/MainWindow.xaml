<Window
    x:Class="FileCommander.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:controls="using:CommunityToolkit.WinUI.Controls" 
    xmlns:controls1="using:FileCommander.Controls"
    xmlns:converters="using:FileCommander.ValueConverters"
    mc:Ignorable="d"
    Closed="Window_Closed">

    <Grid Name="MainGrid">
        <Grid.Resources>
            <ResourceDictionary>
                <XamlUICommand x:Name="ShowHiddenCommand" Label="Versteckte Dateien" Description="Versteckte Dateien werden ebenfalls angezeigt">
                    <!--<XamlUICommand.IconSource>
                        <SymbolIconSource Symbol="Hide"/>
                    </XamlUICommand.IconSource>-->
                    <XamlUICommand.KeyboardAccelerators>
                        <KeyboardAccelerator Key="H" Modifiers="Control"/>
                    </XamlUICommand.KeyboardAccelerators>
                </XamlUICommand>
                <XamlUICommand x:Name="RefreshCommand" Label="Aktualisieren" Description="Alle Einträge neu ermitteln" ExecuteRequested="RefreshCommand_ExecuteRequested">
                    <XamlUICommand.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control"/>
                    </XamlUICommand.KeyboardAccelerators>
                </XamlUICommand>
                <converters:InfoValueConverter x:Key="InfoValueConverter" />
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0"/>
                <ColumnDefinition x:Name="IconColumn" Width="Auto"/>
                <ColumnDefinition x:Name="HamburgerColumn" Width="Auto"/>
                <ColumnDefinition x:Name="TitleColumn" Width="Auto"/>
                <ColumnDefinition x:Name="LeftDragColumn" Width="*"/>
                <ColumnDefinition x:Name="SearchColumn" Width="4*" MinWidth="220"/>
                <ColumnDefinition x:Name="RightDragColumn" Width="*" MinWidth="48"/>
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleBarIcon" Source="ms-appx:///Assets/StoreLogo.png" Grid.Column="1"
                   Width="16" Height="16" Margin="8,0,4,0"/>

            <AppBarButton x:Name="HamburgerButton" Grid.Column="2" FontFamily="Segoe Fluent Icons" 
                          Content="&#xE700;" Width="36" Height="32">
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <ToggleMenuFlyoutItem Command="{StaticResource ShowHiddenCommand}" IsChecked="{Binding ShowHidden, Mode=TwoWay}" />
                        <MenuFlyoutItem Command="{StaticResource RefreshCommand}" />
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Settings" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>

            <TextBlock x:Name="TitleBarTextBlock"
                       Text="App title" 
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Grid.Column="3"
                       VerticalAlignment="Center">
            </TextBlock>
        </Grid>

        <controls:DockPanel Grid.Row="1">
            <Border controls:DockPanel.Dock="Bottom" BorderThickness="1" BorderBrush="LightGray" 
                    Background="{Binding StatusBarTextActive, Converter={StaticResource InfoValueConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition  />
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBlock FontSize="12" Margin="5, 0" Text="{Binding StatusBarText}" ></TextBlock>
                    </Grid>
                    <TextBlock FontSize="12" Grid.Column="1" Margin="5, 0, 0, 0" Text="{Binding CurrentDirectoryCount}"></TextBlock>
                    <TextBlock FontSize="12" Grid.Column="2" Margin="2, 0">Verz.</TextBlock>
                    <TextBlock FontSize="12" Grid.Column="3" Margin="5, 0, 0, 0" Text="{Binding CurrentFileCount}"></TextBlock>
                    <TextBlock FontSize="12" Grid.Column="4" Margin="2, 0, 10, 0">Dateien</TextBlock>
                </Grid>
            </Border>
            <Grid KeyDown="Grid_KeyDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="15" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" MinWidth="15" />
                </Grid.ColumnDefinitions>
                <controls1:FolderView x:Name="LeftView" Id="LeftView" Grid.Column="0" 
                                 HorizontalAlignment="Stretch"
                                 GotFocus="LeftView_GotFocus">
                </controls1:FolderView>
                <Border Grid.Column="1" Width="5" HorizontalAlignment="Stretch" 
                          Background="Transparent"/>
                <controls1:FolderView x:Name="RightView" Id="RightView" Grid.Column="2" 
                                 HorizontalAlignment="Stretch"
                                 GotFocus="RightView_GotFocus">
                </controls1:FolderView>
            </Grid>
        </controls:DockPanel>
    </Grid>
</Window>